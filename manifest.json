{
  "manifest_version": 3,
  "name": "YouTube Digest",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "Read YouTube transcripts and Xiaoyuzhou podcasts, annotate original passages, and archive podcast notes to Obsidian.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.xiaoyuzhoufm.com/episode/*",
    "https://xiaoyuzhoufm.com/episode/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://api.302.ai/*"
  ],
  "action": {
    "default_title": "Open YouTube Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.xiaoyuzhoufm.com/episode/*", "https://xiaoyuzhoufm.com/episode/*"],
      "js": ["media-platform.js", "podcast-core.js", "podcast-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "1.3.0 (Xiaoyuzhou reading and Obsidian annotations)"
}
